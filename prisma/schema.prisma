generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  mahasiswa
  dosen
  kaprodi
  sekpro
  admin_keuangan
  superadmin
}

enum StatusAkun {
  menunggu_persetujuan
  aktif
  ditolak
  nonaktif
}

model Pengguna {
  id                   BigInt        @id @default(autoincrement())
  nama                 String        @db.VarChar(255)
  email                String?       @unique @db.Citext
  emailArsip           String?       @map("email_arsip") @db.VarChar(255)
  password             String        @db.VarChar(255)
  role                 Role
  statusAkun           StatusAkun    @default(menunggu_persetujuan) @map("status_akun")
  catatanPenolakan     String?       @map("catatan_penolakan")
  dibuatOlehSuperAdmin Boolean       @default(false) @map("dibuat_oleh_super_admin")
  wajibGantiPassword   Boolean       @default(false) @map("wajib_ganti_password")
  rememberToken        String?       @map("remember_token") @db.VarChar(100)
  authVersion          Int           @default(0) @map("auth_version")
  createdAt            DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?     @map("updated_at") @db.Timestamp(0)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamp(0)
  mahasiswa            Mahasiswa?
  dosen                Dosen?
  adminKeuangan        AdminKeuangan?
  sessions             AuthSession[]
  resetRequests        PasswordResetRequest[] @relation("ResetOwner")
  approvedResets       PasswordResetRequest[] @relation("ResetApprover")
  biodataRequests      BiodataChangeRequest[] @relation("BiodataOwner")
  biodataDecisions     BiodataChangeRequest[] @relation("BiodataApprover")
  keahlianRequests     KeahlianChangeRequest[] @relation("KeahlianOwner")
  keahlianDecisions    KeahlianChangeRequest[] @relation("KeahlianApprover")
  activityLogs         LogAktivitas[] @relation("AuditActor")
  cancelledActivityLogs LogAktivitas[] @relation("AuditCanceller")
  originalActivityLogs LogAktivitas[] @relation("AuditOriginalActor")
  submissions PengajuanJudul[] @relation("TitleOwner")
  titleReviews PengajuanJudul[] @relation("TitleReviewer")
  titleArchives PengajuanJudul[] @relation("TitleArchiver")
  administrations VerifikasiPembayaran[] @relation("AdministrationOwner")
  administrationReviews VerifikasiPembayaran[] @relation("AdministrationReviewer")
  primarySupervisions Bimbingan[] @relation("PrimarySupervisor")
  secondarySupervisions Bimbingan[] @relation("SecondarySupervisor")
  supervisedLogs LogbookBimbingan[] @relation("LogSupervisor")
  cancelledLogs LogbookBimbingan[] @relation("LogCanceller")
  titleChanges PengajuanPerubahanJudul[]
  lecturerSchedules JadwalBimbingan[] @relation("ScheduleLecturer")
  studentSchedules JadwalBimbingan[] @relation("ScheduleStudent")
  signedDocuments DokumenVerifikasi[] @relation("DocumentSigner")
  revokedDocuments DokumenVerifikasi[] @relation("DocumentRevoker")
  notifications Notifikasi[]

  @@map("pengguna")
}

model Mahasiswa {
  penggunaId BigInt    @id @map("pengguna_id")
  nim        String?   @unique @db.VarChar(50)
  nimArsip   String?   @map("nim_arsip") @db.VarChar(50)
  semester   Int       @db.SmallInt
  noHp       String?   @map("no_hp") @db.VarChar(255)
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)
  pengguna   Pengguna  @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@map("mahasiswa")
}

model Dosen {
  penggunaId     BigInt    @id @map("pengguna_id")
  nidn           String?   @unique @db.VarChar(50)
  nidnArsip      String?   @map("nidn_arsip") @db.VarChar(50)
  noHp           String?   @map("no_hp") @db.VarChar(20)
  kuotaBimbingan Int       @default(8) @map("kuota_bimbingan") @db.SmallInt
  isKaprodi      Boolean   @default(false) @map("is_kaprodi")
  isSekpro       Boolean   @default(false) @map("is_sekpro")
  createdAt      DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(0)
  pengguna       Pengguna  @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  keahlian       DosenKeahlian[]

  @@map("dosen")
}

model AdminKeuangan {
  penggunaId BigInt    @id @map("pengguna_id")
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)
  pengguna   Pengguna  @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@map("admin_keuangan")
}

model AuthSession {
  tokenHash    String   @id @map("token_hash") @db.Char(64)
  publicId     String   @unique @default(uuid()) @map("public_id") @db.Uuid
  penggunaId   BigInt   @map("pengguna_id")
  authVersion  Int      @map("auth_version")
  activeRole   Role     @map("active_role")
  remember     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivity DateTime @map("last_activity") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  pengguna     Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([penggunaId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthRateLimit {
  key         String   @id @db.Char(64)
  attempts    Int
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  @@index([windowStart])
  @@map("auth_rate_limits")
}

model BidangKeahlian {
  id         BigInt @id @default(autoincrement())
  namaBidang String @unique @map("nama_bidang") @db.Citext
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)
  dosen      DosenKeahlian[]
  firstTitles PengajuanJudul[] @relation("TitleField1")
  secondTitles PengajuanJudul[] @relation("TitleField2")
  firstChanges PengajuanPerubahanJudul[] @relation("ChangeField1")
  secondChanges PengajuanPerubahanJudul[] @relation("ChangeField2")
  @@map("bidang_keahlian")
}

model DosenKeahlian {
  dosenId BigInt @map("dosen_id")
  bidangId BigInt @map("bidang_id")
  dosen Dosen @relation(fields: [dosenId], references: [penggunaId], onDelete: Cascade)
  bidang BidangKeahlian @relation(fields: [bidangId], references: [id], onDelete: Restrict)
  @@id([dosenId, bidangId])
  @@map("dosen_keahlian")
}

model PengaturanSistem {
  id BigInt @id @default(autoincrement())
  kunci String @unique @db.VarChar(255)
  nilai String
  keterangan String? @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  @@map("pengaturan_sistem")
}

model PasswordResetRequest {
  id BigInt @id @default(autoincrement())
  penggunaId BigInt @map("pengguna_id")
  identitas String @db.VarChar(255)
  status String @default("menunggu") @db.VarChar(30)
  alasanPenolakan String? @map("alasan_penolakan")
  approvedBy BigInt? @map("approved_by")
  approvedAt DateTime? @map("approved_at") @db.Timestamp(0)
  token String? @unique @db.VarChar(64)
  tokenHash String? @unique @map("token_hash") @db.Char(64)
  authVersion Int? @map("auth_version")
  expiresAt DateTime? @map("expires_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  pengguna Pengguna @relation("ResetOwner", fields: [penggunaId], references: [id], onDelete: Restrict)
  approver Pengguna? @relation("ResetApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  @@index([penggunaId, status])
  @@map("password_reset_requests")
}

model BiodataChangeRequest {
  id BigInt @id @default(autoincrement())
  mahasiswaId BigInt @map("mahasiswa_id")
  namaLama String? @map("nama_lama") @db.VarChar(255)
  namaBaru String? @map("nama_baru") @db.VarChar(255)
  ubahNama Boolean @default(false) @map("ubah_nama")
  emailLama String? @map("email_lama") @db.VarChar(255)
  emailBaru String? @map("email_baru") @db.VarChar(255)
  ubahEmail Boolean @default(false) @map("ubah_email")
  nim String? @db.VarChar(255)
  nimLama String? @map("nim_lama") @db.VarChar(255)
  nimBaru String? @map("nim_baru") @db.VarChar(255)
  ubahNim Boolean @default(false) @map("ubah_nim")
  semesterLama Int? @map("semester_lama") @db.SmallInt
  semesterBaru Int? @map("semester_baru") @db.SmallInt
  ubahSemester Boolean @default(false) @map("ubah_semester")
  noHpLama String? @map("no_hp_lama") @db.VarChar(255)
  noHpBaru String? @map("no_hp_baru") @db.VarChar(255)
  ubahNoHp Boolean @default(false) @map("ubah_no_hp")
  rincianData String? @map("rincian_data")
  alasan String
  status String @default("pending") @db.VarChar(30)
  catatanKaprodi String? @map("catatan_kaprodi")
  diputuskanOleh BigInt? @map("diputuskan_oleh")
  diputuskanAt DateTime? @map("diputuskan_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  mahasiswa Pengguna @relation("BiodataOwner", fields: [mahasiswaId], references: [id], onDelete: Restrict)
  approver Pengguna? @relation("BiodataApprover", fields: [diputuskanOleh], references: [id], onDelete: SetNull)
  @@index([mahasiswaId, status])
  @@map("biodata_change_requests")
}

model KeahlianChangeRequest {
  id BigInt @id @default(autoincrement())
  dosenId BigInt @map("dosen_id")
  namaLama String? @map("nama_lama") @db.VarChar(255)
  namaBaru String? @map("nama_baru") @db.VarChar(255)
  ubahNama Boolean @default(false) @map("ubah_nama")
  emailLama String? @map("email_lama") @db.VarChar(255)
  emailBaru String? @map("email_baru") @db.VarChar(255)
  ubahEmail Boolean @default(false) @map("ubah_email")
  nidnLama String? @map("nidn_lama") @db.VarChar(50)
  nidnBaru String? @map("nidn_baru") @db.VarChar(50)
  ubahNidn Boolean @default(false) @map("ubah_nidn")
  noHpLama String? @map("no_hp_lama") @db.VarChar(20)
  noHpBaru String? @map("no_hp_baru") @db.VarChar(20)
  ubahNoHp Boolean @default(false) @map("ubah_no_hp")
  keahlianLama Json? @map("keahlian_lama")
  keahlianDiajukan Json? @map("keahlian_diajukan")
  ubahKeahlian Boolean @default(false) @map("ubah_keahlian")
  alasan String?
  status String @default("pending") @db.VarChar(30)
  catatanKaprodi String? @map("catatan_kaprodi")
  diputuskanOleh BigInt? @map("diputuskan_oleh")
  diputuskanAt DateTime? @map("diputuskan_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  dosen Pengguna @relation("KeahlianOwner", fields: [dosenId], references: [id], onDelete: Restrict)
  approver Pengguna? @relation("KeahlianApprover", fields: [diputuskanOleh], references: [id], onDelete: SetNull)
  @@index([dosenId, status])
  @@map("keahlian_change_requests")
}

model LogAktivitas {
  id BigInt @id @default(autoincrement())
  penggunaId BigInt? @map("pengguna_id")
  aksi String @db.VarChar(255)
  entitasTerkait String @map("entitas_terkait") @db.VarChar(255)
  waktu DateTime @default(now()) @db.Timestamp(0)
  detail Json?
  data Json?
  status String @default("aktif") @db.VarChar(30)
  dibatalkanAt DateTime? @map("dibatalkan_at") @db.Timestamp(0)
  dibatalkanOlehId BigInt? @map("dibatalkan_oleh_id")
  pelakuAsliId BigInt? @map("pelaku_asli_id")
  alasanPembatalan String? @map("alasan_pembatalan")
  pengguna Pengguna? @relation("AuditActor", fields: [penggunaId], references: [id], onDelete: SetNull)
  canceller Pengguna? @relation("AuditCanceller", fields: [dibatalkanOlehId], references: [id], onDelete: SetNull)
  originalActor Pengguna? @relation("AuditOriginalActor", fields: [pelakuAsliId], references: [id], onDelete: SetNull)
  @@index([waktu])
  @@map("log_aktivitas")
}

model LogSuperAdmin {
  id BigInt @id @default(autoincrement())
  waktu DateTime @default(now()) @db.Timestamp(0)
  aksi String @db.VarChar(255)
  targetType String? @map("target_type") @db.VarChar(255)
  targetIdentifier String? @map("target_identifier") @db.VarChar(255)
  targetNama String? @map("target_nama") @db.VarChar(255)
  dataSebelum Json? @map("data_sebelum")
  dataSesudah Json? @map("data_sesudah")
  alasan String?
  hasil String @default("berhasil") @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  @@map("log_super_admin")
}

model VerifikasiPembayaran {
  id BigInt @id @default(autoincrement())
  idMahasiswa BigInt @map("id_mahasiswa")
  idAdminKeuangan BigInt? @map("id_admin_keuangan")
  fileKwitansi String? @map("file_kwitansi") @db.VarChar(255)
  fileKrsSka String? @map("file_krs_ska") @db.VarChar(255)
  fileBuktiTransfer String? @map("file_bukti_transfer") @db.VarChar(255)
  tanggalTransfer DateTime? @map("tanggal_transfer") @db.Date
  namaPengirim String? @map("nama_pengirim") @db.VarChar(255)
  statusVerifikasi String @default("menunggu_verifikasi") @map("status_verifikasi") @db.VarChar(30)
  catatanPenolakan String? @map("catatan_penolakan")
  perluVerifikasiUlang Boolean @default(false) @map("perlu_verifikasi_ulang")
  periode String? @db.VarChar(100)
  siklusKe Int @default(1) @map("siklus_ke") @db.SmallInt
  snapshotVersion String? @map("snapshot_version") @db.VarChar(80)
  revision Int @default(1)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  mahasiswa Pengguna @relation("AdministrationOwner", fields: [idMahasiswa], references: [id], onDelete: Restrict)
  reviewer Pengguna? @relation("AdministrationReviewer", fields: [idAdminKeuangan], references: [id], onDelete: SetNull)
  @@index([idMahasiswa, statusVerifikasi])
  @@map("verifikasi_pembayaran")
}

model PengajuanJudul {
  id BigInt @id @default(autoincrement())
  idMahasiswa BigInt @map("id_mahasiswa")
  bidangKeahlianId BigInt? @map("bidang_keahlian_id")
  bidangKeahlian2Id BigInt? @map("bidang_keahlian_2_id")
  judul String @db.VarChar(255)
  fileProposal String @map("file_proposal") @db.VarChar(255)
  matriksPenelitian Json? @map("matriks_penelitian")
  status String @default("diajukan") @db.VarChar(30)
  statusDraft String @default("draft") @map("status_draft") @db.VarChar(30)
  draftData Json? @map("draft_data")
  counterPengajuan Int @default(0) @map("counter_pengajuan")
  catatanKaprodi String? @map("catatan_kaprodi")
  preferensiDosenIds Json? @map("preferensi_dosen_ids")
  skorKemiripan Int? @map("skor_kemiripan")
  judulTermirip String? @map("judul_termirip")
  penulisTermirip String? @map("penulis_termirip") @db.VarChar(255)
  nimTermirip String? @map("nim_termirip") @db.VarChar(50)
  tahunTermirip Int? @map("tahun_termirip")
  topKemiripan Json? @map("top_kemiripan")
  tanggalPengajuan DateTime? @map("tanggal_pengajuan") @db.Timestamp(0)
  tanggalPersetujuan DateTime? @map("tanggal_persetujuan") @db.Timestamp(0)
  lastVerifierId BigInt? @map("last_verifier_id")
  lastVerifierRole String? @map("last_verifier_role") @db.VarChar(30)
  semesterSaatPengajuan Int? @map("semester_saat_pengajuan") @db.SmallInt
  periodeAkademikSaatPengajuan String? @map("periode_akademik_saat_pengajuan") @db.VarChar(255)
  siklusKe Int @default(1) @map("siklus_ke") @db.SmallInt
  snapshotVersion String? @map("snapshot_version") @db.VarChar(80)
  isDiarsipkan Boolean @default(false) @map("is_diarsipkan")
  diarsipkanAt DateTime? @map("diarsipkan_at") @db.Timestamp(0)
  diarsipkanOlehId BigInt? @map("diarsipkan_oleh_id")
  alasanArsip String? @map("alasan_arsip")
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  mahasiswa Pengguna @relation("TitleOwner", fields: [idMahasiswa], references: [id], onDelete: Restrict)
  reviewer Pengguna? @relation("TitleReviewer", fields: [lastVerifierId], references: [id], onDelete: SetNull)
  archiver Pengguna? @relation("TitleArchiver", fields: [diarsipkanOlehId], references: [id], onDelete: SetNull)
  bidang1 BidangKeahlian? @relation("TitleField1", fields: [bidangKeahlianId], references: [id], onDelete: SetNull)
  bidang2 BidangKeahlian? @relation("TitleField2", fields: [bidangKeahlian2Id], references: [id], onDelete: SetNull)
  bimbingan Bimbingan?
  documents DokumenVerifikasi[]
  @@index([idMahasiswa, isDiarsipkan, deletedAt])
  @@index([status, statusDraft])
  @@map("pengajuan_judul")
}

model Bimbingan {
  id BigInt @id @default(autoincrement())
  idPengajuan BigInt @unique @map("id_pengajuan")
  idDosenPembimbing BigInt? @map("id_dosen_pembimbing")
  idDosenPembimbing2 BigInt? @map("id_dosen_pembimbing_2")
  tanggalPenetapan DateTime @map("tanggal_penetapan") @db.Date
  catatanPermintaanMhs String? @map("catatan_permintaan_mhs")
  pembatalanP1 Json? @map("pembatalan_p1")
  pembatalanP2 Json? @map("pembatalan_p2")
  siklusKe Int @default(1) @map("siklus_ke") @db.SmallInt
  // Written only by the later sempro lifecycle after an official pass or completed revision.
  faseSkripsiAt DateTime? @map("fase_skripsi_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  pengajuan PengajuanJudul @relation(fields: [idPengajuan], references: [id], onDelete: Restrict)
  pembimbing1 Pengguna? @relation("PrimarySupervisor", fields: [idDosenPembimbing], references: [id], onDelete: SetNull)
  pembimbing2 Pengguna? @relation("SecondarySupervisor", fields: [idDosenPembimbing2], references: [id], onDelete: SetNull)
  logbook LogbookBimbingan[]
  changes PengajuanPerubahanJudul[]
  schedules JadwalBimbingan[]
  documents DokumenVerifikasi[]
  @@index([idDosenPembimbing])
  @@index([idDosenPembimbing2])
  @@map("bimbingan")
}

model LogbookBimbingan {
  id BigInt @id @default(autoincrement())
  idBimbingan BigInt @map("id_bimbingan")
  idDosen BigInt? @map("id_dosen")
  fase String @default("sempro") @db.VarChar(20)
  siklusKe Int @default(1) @map("siklus_ke") @db.SmallInt
  tanggal DateTime @db.Date
  catatan String
  catatanMahasiswa String? @map("catatan_mahasiswa")
  statusSelesai Boolean @default(false) @map("status_selesai")
  isDibatalkan Boolean @default(false) @map("is_dibatalkan")
  dibatalkanAt DateTime? @map("dibatalkan_at") @db.Timestamp(0)
  dibatalkanOlehId BigInt? @map("dibatalkan_oleh_id")
  alasanPembatalan String? @map("alasan_pembatalan")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  bimbingan Bimbingan @relation(fields: [idBimbingan], references: [id], onDelete: Restrict)
  dosen Pengguna? @relation("LogSupervisor", fields: [idDosen], references: [id], onDelete: SetNull)
  canceller Pengguna? @relation("LogCanceller", fields: [dibatalkanOlehId], references: [id], onDelete: SetNull)
  @@index([idBimbingan, fase, siklusKe])
  @@map("logbook_bimbingan")
}

model PengajuanPerubahanJudul {
  id BigInt @id @default(autoincrement())
  bimbinganId BigInt @map("bimbingan_id")
  judulLama String @map("judul_lama")
  judulBaru String @map("judul_baru")
  alasan String
  matriksLama Json? @map("matriks_lama")
  matriksBaru Json? @map("matriks_baru")
  bidangKeahlianIdBaru BigInt? @map("bidang_keahlian_id_baru")
  bidangKeahlian2IdBaru BigInt? @map("bidang_keahlian_2_id_baru")
  jenisPerubahan String @default("revisi_minor") @map("jenis_perubahan") @db.VarChar(30)
  status String @default("menunggu_dospem") @db.VarChar(30)
  catatanDospem String? @map("catatan_dospem")
  catatanInternalDospem String? @map("catatan_internal_dospem")
  catatanKaprodi String? @map("catatan_kaprodi")
  konfirmasiDospem1At DateTime? @map("konfirmasi_dospem_1_at") @db.Timestamp(0)
  konfirmasiDospem2At DateTime? @map("konfirmasi_dospem_2_at") @db.Timestamp(0)
  disetujuiDospem1 Boolean? @map("disetujui_dospem_1")
  disetujuiDospem2 Boolean? @map("disetujui_dospem_2")
  skorKemiripan Int? @map("skor_kemiripan")
  penyetujuId BigInt? @map("penyetuju_id")
  penyetujuRole String? @map("penyetuju_role") @db.VarChar(30)
  keputusanAt DateTime? @map("keputusan_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  bimbingan Bimbingan @relation(fields: [bimbinganId], references: [id], onDelete: Restrict)
  approver Pengguna? @relation(fields: [penyetujuId], references: [id], onDelete: SetNull)
  bidang1 BidangKeahlian? @relation("ChangeField1", fields: [bidangKeahlianIdBaru], references: [id], onDelete: SetNull)
  bidang2 BidangKeahlian? @relation("ChangeField2", fields: [bidangKeahlian2IdBaru], references: [id], onDelete: SetNull)
  @@index([bimbinganId, status])
  @@map("pengajuan_perubahan_judul")
}

