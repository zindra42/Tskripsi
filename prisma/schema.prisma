model DokumenVerifikasi {
  id BigInt @id @default(autoincrement())
  jenisDokumen String @map("jenis_dokumen") @db.VarChar(50)
  token String @unique @db.VarChar(64)
  idPengajuan BigInt? @map("id_pengajuan")
  idBimbingan BigInt? @map("id_bimbingan")
  // Later domain migrations attach the corresponding sempro/sidang foreign keys.
  idSempro BigInt? @map("id_sempro")
  idJadwal BigInt? @map("id_jadwal")
  idSidang BigInt? @map("id_sidang")
  idJadwalSidang BigInt? @map("id_jadwal_sidang")
  penandatanganUserId BigInt? @map("penandatangan_user_id")
  namaPenandatangan String @map("nama_penandatangan") @db.VarChar(255)
  jabatanSnapshot String? @map("jabatan_snapshot") @db.VarChar(255)
  peran String? @db.VarChar(50)
  nomorSurat String? @map("nomor_surat") @db.VarChar(255)
  status String @default("sah") @db.VarChar(30)
  versi Int @default(1)
  digantikanOlehId BigInt? @map("digantikan_oleh_id")
  snapshotJson Json? @map("snapshot_json")
  hashSha256 String? @map("hash_sha256") @db.Char(64)
  diterbitkanAt DateTime? @map("diterbitkan_at") @db.Timestamp(0)
  dicabutAt DateTime? @map("dicabut_at") @db.Timestamp(0)
  alasanPencabutan String? @map("alasan_pencabutan")
  dicabutOlehId BigInt? @map("dicabut_oleh_id")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  pengajuan PengajuanJudul? @relation(fields: [idPengajuan], references: [id], onDelete: Restrict)
  bimbingan Bimbingan? @relation(fields: [idBimbingan], references: [id], onDelete: Restrict)
  signer Pengguna? @relation("DocumentSigner", fields: [penandatanganUserId], references: [id], onDelete: SetNull)
  revoker Pengguna? @relation("DocumentRevoker", fields: [dicabutOlehId], references: [id], onDelete: SetNull)
  replacement DokumenVerifikasi? @relation("DocumentReplacement", fields: [digantikanOlehId], references: [id], onDelete: SetNull)
  predecessors DokumenVerifikasi[] @relation("DocumentReplacement")
  @@index([idBimbingan, jenisDokumen, status])
  @@map("dokumen_verifikasi")
}

model Notifikasi {
