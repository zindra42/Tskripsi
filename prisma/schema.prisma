  konfirmasi KonfirmasiJadwalSempro? @relation(fields: [konfirmasiId], references: [id], onDelete: Restrict)
  pemohon Pengguna @relation("LegacySemproApplicant", fields: [pemohonUserId], references: [id], onDelete: Restrict)
  pengganti Pengguna? @relation("LegacySemproSubstitute", fields: [dosenPenggantiId], references: [id], onDelete: Restrict)
  pemutus Pengguna? @relation("LegacySemproDecider", fields: [keputusanOleh], references: [id], onDelete: Restrict)
  @@map("permohonan_sempro")
}

// Import journal and immutable source rows are deliberately separate from business receipts.
model LegacyImportRun {
  binding String @id @db.Char(64)
  snapshotId String @map("snapshot_id") @unique @db.VarChar(100)
  snapshotChecksum String @map("snapshot_checksum") @db.Char(64)
  mappingVersion String @map("mapping_version") @db.VarChar(100)
  @@map("legacy_import_runs")
}

model LegacyImportCheckpoint {
  binding String @db.Char(64)
  stage String @db.VarChar(100)
  checksum String @db.Char(64)
  @@id([binding, stage])
  @@map("legacy_import_checkpoints")
}

model LegacyImportRow {
  sourceTable String @map("source_table") @db.VarChar(100)
  sourcePk String @map("source_pk") @db.VarChar(500)
  binding String @db.Char(64)
  sourceJson Json @map("source_json")
  sourceChecksum String @map("source_checksum") @db.Char(64)
  provenance Json
  @@id([sourceTable, sourcePk])
  @@index([binding])
  @@map("legacy_import_rows")
}

model LegacyImportFile {
  id String @id @db.Char(64)
  binding String @db.Char(64)
  disk String @db.VarChar(7)
  path String @db.VarChar(1000)
  descriptor Json
  @@index([path])
  @@map("legacy_import_files")
}
