// A committed receipt makes form retries idempotent, including file uploads.
model AcademicReceipt {
  key String @id @db.Uuid
  actorId BigInt @map("actor_id")
  command String @db.VarChar(80)
  fingerprint String @db.Char(64)
  result Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("academic_receipts")
}
