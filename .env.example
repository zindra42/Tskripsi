# Isi melalui pengelola environment lokal. File ini hanya berisi placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sias?schema=public
APP_ORIGIN=http://localhost:3000
# Buat nilai acak minimal 32 karakter. Digunakan untuk HMAC kunci rate limit.
AUTH_RATE_LIMIT_SECRET=
# Aktifkan hanya jika proxy terpercaya menimpa X-Forwarded-For dari klien.
TRUST_PROXY=false
# Lokal, di luar web root. Subfolder private/ dan public/ mengikuti disk Laravel.
SIAS_STORAGE_ROOT=.sias-storage
